<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:width="8dp" android:height="8dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/md_theme_primary" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="6dp" android:height="6dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/text_secondary" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
