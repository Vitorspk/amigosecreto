<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="space_screen">20dp</dimen>
    <dimen name="space_card">20dp</dimen>
    <dimen name="radius_card">18dp</dimen>
    <dimen name="radius_button">14dp</dimen>
    <style
        name="TextAppearance.Amigo.Display"
        parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style
        name="TextAppearance.Amigo.Title"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style
        name="Widget.Amigo.Button"
        parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style
        name="Widget.Amigo.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style
        name="Widget.Amigo.Button.Text"
        parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style
        name="Widget.Amigo.Card"
        parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style
        name="Widget.Amigo.TextInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>
    <style
        name="TextAppearance.Amigo.Subtitle"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style
        name="Widget.Amigo.Toolbar"
        parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Amigo.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Amigo.Subtitle</item>
    </style>
    <style
        name="Widget.Amigo.AppBarLayout"
        parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/background</item>
        <item name="liftOnScroll">false</item>
        <item name="statusBarForeground">@null</item>
    </style>
</resources>
