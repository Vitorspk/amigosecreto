<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_grupo_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="1dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="?attr/colorControlHighlight"
    style="@style/Widget.Amigo.Card"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/layout_grupo_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:paddingBottom="12dp">
            <TextView
                android:id="@+id/tv_grupo_emoji"
                android:layout_width="48dp"
                android:layout_height="48dp"
                tools:text="🎅"
                android:importantForAccessibility="no"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_soft" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_grupo_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Festa de Natal"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/md_theme_primary" />
                    <TextView
                        android:id="@+id/tv_grupo_participantes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="6 Participantes"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_dots"
                android:layout_marginStart="8dp"
                app:tint="@color/text_secondary"
                android:id="@+id/btn_grupo_options"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/group_options" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_action_strip">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/v2_group_context"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tv_grupo_context"
                android:layout_weight="1" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_forward"
                android:importantForAccessibility="no"
                app:tint="@color/md_theme_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
