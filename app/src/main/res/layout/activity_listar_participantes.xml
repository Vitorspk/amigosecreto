<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_participantes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/background"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_grupos"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextAppearance="@style/TextAppearance.Amigo.Title"
            app:titleTextColor="@color/text_primary"
            app:navigationIconTint="@color/text_primary" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_hero"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v2_event_eyebrow"
                android:textSize="10sp"
                android:textColor="@color/brand_gold"
                android:letterSpacing="0.14"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <TextView
                android:id="@+id/tv_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_no_participants"
                android:textColor="@color/hero_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_data_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hero_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Evento: 25/12/2026" />
            <TextView
                android:id="@+id/tv_faixa_valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hero_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Valor: R$ 50,00 – R$ 100,00" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_busca"
            style="@style/Widget.Amigo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_buscar_participante"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_secondary"
            app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_busca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/scroll_participantes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout
            android:id="@+id/layout_scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin">
            <ViewStub
                android:id="@+id/stub_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/loading_state"
                android:visibility="gone" />
            <ViewStub
                android:id="@+id/stub_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/empty_state"
                android:visibility="gone" />
            <ListView
                android:id="@+id/lv_participantes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_participante" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_buttons"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_add_participante"
            style="@style/Widget.Amigo.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/button_add"
            app:icon="@drawable/ic_person_add"
            app:iconGravity="textStart"
            android:layout_weight="1"
            android:textSize="14sp"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:iconSize="20dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/button_add_participant" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sortear"
            style="@style/Widget.Amigo.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/v2_draw_short"
            app:icon="@drawable/ic_dice"
            app:iconGravity="textStart"
            android:layout_weight="1"
            android:textSize="14sp"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:iconSize="20dp"
            android:contentDescription="@string/button_draw" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
